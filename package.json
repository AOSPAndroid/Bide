{
  "name": "bide",
  "version": "0.8.16",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo --host 127.0.0.1",
    "build": "tsc -b && vite build --mode demo",
    "preview": "vite preview --mode demo --host 127.0.0.1",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test-browser.mjs",
    "assets:office": "node scripts/fetch-office.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs && node scripts/prepare-ai.mjs",
    "build:demo": "tsc -b && vite build --mode demo",
    "assets:ocr": "node scripts/prepare-ocr.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/ocr-replace.e2e.mjs tests/e2e/ocr-appearance.e2e.mjs tests/e2e/ai.e2e.mjs tests/e2e/selection.e2e.mjs tests/e2e/paint.e2e.mjs tests/e2e/canvas-tools.e2e.mjs tests/e2e/searchable.e2e.mjs tests/e2e/proofread.e2e.mjs tests/e2e/straighten.e2e.mjs tests/e2e/alphabets.e2e.mjs tests/e2e/redact.e2e.mjs tests/e2e/adjustments.e2e.mjs tests/e2e/forms.e2e.mjs tests/e2e/object-select.e2e.mjs tests/e2e/paywall.e2e.mjs tests/e2e/model-parts.e2e.mjs tests/e2e/invoices.e2e.mjs tests/e2e/pdf-scan-softness.e2e.mjs tests/e2e/touch.e2e.mjs tests/e2e/scan-edit.e2e.mjs",
    "assets:ai": "node scripts/prepare-ai.mjs",
    "test:real": "node scripts/test-real.mjs",
    "prebuild:saas": "node scripts/prepare-ocr.mjs && node scripts/prepare-ai.mjs",
    "build:saas": "tsc -b && vite build --mode saas && node cloud/check-build.mjs",
    "test:cloud": "node scripts/test-cloud.mjs",
    "build:app": "tsc -b && vite build --mode app && cap sync",
    "typecheck:cloud": "tsc -p cloud/tsconfig.json",
    "bench:ocr": "node scripts/ocr-bench.mjs",
    "build:all": "tsc -b && vite build && vite build --mode demo",
    "prebuild:all": "node scripts/prepare-ocr.mjs && node scripts/prepare-ai.mjs && node scripts/check-assets.mjs",
    "build:local": "tsc -b && vite build",
    "prebuild:local": "node scripts/prepare-ocr.mjs && node scripts/prepare-ai.mjs && node scripts/check-assets.mjs",
    "check:discovery": "node scripts/check-discovery.mjs out",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "test:measurement": "node tests/measurement.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3",
    "@noble/hashes": "1.8.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "ag-psd": "31.0.2",
    "dictionary-en": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "docx": "^9.7.1",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "mupdf": "^1.28.1",
    "nspell": "^2.1.5",
    "onnxruntime-web": "^1.23.2",
    "pdf-lib": "1.17.1",
    "pdfkit": "^0.20.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svg-to-pdfkit": "^0.1.8",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "@tesseract.js-data/nld": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@vitejs/plugin-react": "^4.3.4",
    "onnx-proto": "^8.0.1",
    "playwright-core": "^1.56.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
