{
  "name": "bide",
  "version": "0.8.13",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --mode demo",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test-browser.mjs",
    "assets:office": "node scripts/fetch-office.mjs",
    "assets:diagrams": "node scripts/fetch-diagrams.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs && node scripts/prepare-ai.mjs && node scripts/check-assets.mjs",
    "build:demo": "tsc -b && vite build --mode demo",
    "assets:ocr": "node scripts/prepare-ocr.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/ocr-replace.e2e.mjs tests/e2e/ai.e2e.mjs tests/e2e/selection.e2e.mjs tests/e2e/paint.e2e.mjs tests/e2e/canvas-tools.e2e.mjs tests/e2e/searchable.e2e.mjs",
    "assets:ai": "node scripts/prepare-ai.mjs",
    "test:real": "node scripts/test-real.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "ag-psd": "31.0.2",
    "docx": "^9.7.1",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "mupdf": "^1.28.1",
    "onnxruntime-web": "^1.23.2",
    "pdfkit": "^0.20.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svg-to-pdfkit": "^0.1.8",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "@tesseract.js-data/nld": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@vitejs/plugin-react": "^4.3.4",
    "onnx-proto": "^8.0.1",
    "playwright-core": "^1.56.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
